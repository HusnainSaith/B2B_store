# =====================================================
# Zerox-Store Production Environment Template
# =====================================================
# Set the FULL contents of this file (with real values)
# as the GitHub repository secret: PRODUCTION_ENV
#
# NEVER commit real secrets to the repository.

NODE_ENV=production
PORT=3001
TRUST_PROXY=true

# Comma-separated allowed frontend origins
# Update when domain is purchased
FRONTEND_URLS=http://SERVER_IP,http://SERVER_IP:8080,http://SERVER_IP:8081
FRONTEND_URL=http://SERVER_IP

# Database (Docker internal hostname)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=CHANGE_ME
DB_DATABASE=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Cloudflare R2
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_ENDPOINT=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
R2_PUBLIC_URL=CHANGE_ME

# Email / SMTP
NOTIFICATION_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=CHANGE_ME
EMAIL_PASS=CHANGE_ME
MAIL_FROM=CHANGE_ME
ADMIN_EMAIL=CHANGE_ME

# Stripe
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_CURRENCY=pkr

# Super Admin (seed only)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME
